# ============================================================
# AVLpoint — environment template
# Copy to .env and fill in real values. Names below match what
# the code actually reads (src/lib/*, pipeline scripts).
# ============================================================

# --- Web app: auth ---
# Session signing secret for auth cookies. REQUIRED in production;
# weak/default values are rejected at startup (src/lib/auth.ts).
AUTH_SECRET=change-me-in-production

# --- Web app: Claude AI layer (src/lib/ai.ts, /api/chat) ---
# Either name works; AVL_ANTHROPIC_API_KEY wins if both are set.
# Leave unset to run search-only (zero AI cost).
AVL_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: local gateway/proxy for caching & spend controls
# AVL_AI_BASE_URL=http://localhost:8787
# Swappable model constants
AVL_AI_MODEL=claude-sonnet-4-6
AVL_AI_MODEL_FAST=claude-haiku-4-5-20251001

# --- Backups (src/lib/backup.ts) ---
BACKUP_EXTERNAL_DIR=e:\backupavl

# --- Data pipeline (Python: enrichment.py, pipeline_v2.py, sources/) ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=
ENRICH_PRICE_IN_PER_M=
ENRICH_PRICE_OUT_PER_M=
NIMBLE_API_KEY=your_nimble_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
USE_FIRECRAWL=true
AVL_ENRICH_PROVIDER=
SESSION_CREDIT_LIMIT_USD=
PER_COMPANY_SPEND_LIMIT_USD=

# --- Later: Supabase migration (see migrate_to_supabase.py) ---
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_anon_key

# --- Pipeline v3: Gemini (Vertex AI express mode) ---
# Set as a SYSTEM env var, not here. Works via aiplatform.googleapis.com ?key=
# (generativelanguage endpoint is blocked for this key). Used for junk triage
# (flash-lite) and contact extraction fallback (flash). OpenRouter is fallback.
# GEMINI_API_KEY=your_vertex_express_key
# GEMINI_DAILY_CAP=3000
